+    if (!mounted) return;
+    setState(() {
+      _steps[index] = _StartupStep(_steps[index].label, _StartupStepState.done);
+      if (_failedStep == index) _failedStep = null;
+    });
+  }
+
+  void _failCurrent(String message) {
+    if (!mounted) return;
+    setState(() {
+      _running = false;
+      _error = message;
+      final index = _failedStep;
+      if (index != null) {
