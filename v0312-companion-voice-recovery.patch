+++ b/tools/validate_v0312_companion_voice.py
@@ -0,0 +1,238 @@
+#!/usr/bin/env python3
+from __future__ import annotations
+
+import hashlib
+import re
+import xml.etree.ElementTree as ET
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+FROZEN = {
+    'android/app/src/main/kotlin/com/aicompanion/localfirst/OverlayBubbleService.kt': 'a622f882573c3e230627e9db01e0c58215440670c75147149b2509a79489ad6d',
+    'android/app/src/main/kotlin/com/aicompanion/localfirst/MainActivity.kt': 'c581b4cb93c5979ccb5d413904cd43dd1a7046a0d66ab7b75acf6e4cfbafc36b',
+    'lib/core/tts/tts_service.dart': '691605c38107e1d4293f1fdbb176e51392555c7d39ee07abe006f0c01cffa47f',
+    'lib/core/tts/tts_playback_queue.dart': '4cdd466553664b3039d81c30ff4cad2cb71dc2ea8fb6234a5371c153a8adfc5b',
+    'lib/core/desire/desire_core_policy.dart': 'd28f0fb575ed2d7b32bb186e5058c07432a30a5aa81b76a5474a9f298c7dcab5',
+    'lib/core/presence/presence_intelligence.dart': '207ef1d779fbab5c9d091037679fec8101663053296779c90cb8a17b009825ec',
+    'android/app/src/main/jniLibs/arm64-v8a/libbertvits2.so': 'a599d482539fdbe01ccd82a9c688d0dce574c19dd681b15fd580185890e65792',
+}
+
+
+def text(rel: str) -> str:
+    return (ROOT / rel).read_text(encoding='utf-8')
+
+
+def sha(rel: str) -> str:
+    return hashlib.sha256((ROOT / rel).read_bytes()).hexdigest()
+
+
+def require(haystack: str, tokens: list[str], name: str) -> None:
+    for token in tokens:
+        assert token in haystack, f'{name}: missing {token!r}'
+
+
+def check_relative_dart_imports() -> None:
+    pattern = re.compile(r"^\s*import\s+['\"]([^'\"]+)['\"]", re.M)
+    missing = []
+    for path in list((ROOT / 'lib').rglob('*.dart')) + list((ROOT / 'test').rglob('*.dart')):
+        for target in pattern.findall(path.read_text(encoding='utf-8')):
+            if target.startswith(('dart:', 'package:')):
+                continue
+            if not (path.parent / target).resolve().exists():
+                missing.append(f'{path.relative_to(ROOT)} -> {target}')
+    assert not missing, '\n'.join(missing)
+
+
+def strip_comments_and_strings(source: str) -> str:
+    out: list[str] = []
+    i = 0
+    state = 'code'
+    quote = ''
+    triple = False
+    while i < len(source):
+        c = source[i]
+        nxt = source[i + 1] if i + 1 < len(source) else ''
+        if state == 'line':
+            if c == '\n': state = 'code'; out.append('\n')
+            else: out.append(' ')
+            i += 1; continue
+        if state == 'block':
+            if c == '*' and nxt == '/': out += [' ', ' ']; i += 2; state = 'code'
+            else: out.append('\n' if c == '\n' else ' '); i += 1
+            continue
+        if state == 'string':
+            if triple:
+                if source.startswith(quote * 3, i): out += [' ', ' ', ' ']; i += 3; state = 'code'; triple = False
+                else: out.append('\n' if c == '\n' else ' '); i += 1
+            else:
+                if c == '\\':
+                    out.append(' '); i += 1
+                    if i < len(source): out.append('\n' if source[i] == '\n' else ' '); i += 1
+                elif c == quote: out.append(' '); i += 1; state = 'code'
+                else: out.append('\n' if c == '\n' else ' '); i += 1
+            continue
+        if c == '/' and nxt == '/': out += [' ', ' ']; i += 2; state = 'line'; continue
+        if c == '/' and nxt == '*': out += [' ', ' ']; i += 2; state = 'block'; continue
+        if c in ("'", '"'):
+            quote = c; triple = source.startswith(c * 3, i)
+            out += [' ', ' ', ' '] if triple else [' ']
+            i += 3 if triple else 1; state = 'string'; continue
+        out.append(c); i += 1
+    return ''.join(out)
+
+
+def check_delimiters() -> None:
+    pairs = {')': '(', ']': '[', '}': '{'}
+    for path in list((ROOT / 'lib').rglob('*.dart')) + list((ROOT / 'test').rglob('*.dart')):
+        cleaned = strip_comments_and_strings(path.read_text(encoding='utf-8'))
+        stack: list[str] = []
+        for ch in cleaned:
+            if ch in '([{': stack.append(ch)
+            elif ch in pairs:
+                assert stack and stack[-1] == pairs[ch], f'delimiter mismatch: {path}'
+                stack.pop()
+        assert not stack, f'unclosed delimiter: {path}: {stack[-8:]}'
+
+
+def main() -> int:
+    pubspec = text('pubspec.yaml')
+    assert 'version: 0.31.2+42' in pubspec
+
+    db = text('lib/core/database/app_database.dart')
+    require(db, [
+        'static const int schemaVersion = 19;',
+        'inner_voice TEXT NOT NULL DEFAULT',
+        'if (oldVersion < 19)',
+        'ALTER TABLE messages ADD COLUMN inner_voice',
+        'companion_voice_protocol',
+        "if (table == 'messages' && version < 19)",
+        '_legacyInnerVoiceCandidate',
+    ], 'database')
+    assert "reasoning_content NOT LIKE '%我们需要回答用户%'" in db
+
+    message = text('lib/core/models/chat_message.dart')
+    require(message, ['final String innerVoice;', "'inner_voice': innerVoice", "row['inner_voice']"], 'ChatMessage')
+
+    protocol = text('lib/core/ai/companion_voice_protocol.dart')
+    require(protocol, [
+        '<companion_inner>', '<companion_reply>',
+        '我们需要回答用户', '用户要求', '长期相处的 AI 女友',
+        '稀疏', 'isAgenticMeta', 'fallbackReply',
+        'partial.innerClosed', '_safeInnerEstablished',
+        'return isAgenticMeta(candidate) ?',
+        '两个闭合标签都必须完整输出',
+    ], 'voice protocol')
+
+    profile = text('lib/core/ai/model_profile.dart')
+    require(profile, [
+        'CompanionModelCompatibility',
+        'rawReasoningMayBeAgentic',
+        'useCompanionVoiceProtocol',
+        'deepseek_v4_agentic_reasoning_v1',
+    ], 'model profile')
+
+    prompt = text('lib/core/ai/prompt_builder.dart')
+    require(prompt, [
+        '持续存在的女性 AI 伴侣',
+        '直接从“我正在和熟悉的伴侣相处”',
+        '用户这一轮正在明确启动角色扮演',
+        '好，现在我是X了',
+        'CompanionVoiceProtocol.outputInstruction',
+        'bool includeVoiceProtocol = true',
+        'if (includeVoiceProtocol)',
+    ], 'prompt')
+    assert "mode == PromptGenerationMode.proactive ? '' : latestUserText" in prompt
+
+    rules = text('lib/core/rules/rule_layer_service.dart')
+    require(rules, ['【幕后行为边界】', '不要在可见内心或正文里逐条复述'], 'rule layer framing')
+
+    runner = text('lib/core/ai/durable_generation_runner.dart')
+    require(runner, [
+        "reasoningContent: rawReasoning.trim()",
+        'innerVoice: completedAttempt ? parsed.innerVoice.trim() :',
+        'CompanionVoiceProtocol.fallbackReply(rawContent)',
+        "_noteVoiceRepair('missing_companion_voice_protocol')",
+        'CompanionVoiceStreamDecoder()',
+    ], 'durable generation')
+    # raw reasoning must not be emitted as the visible streaming channel.
+    assert 'onDelta?.call(DeepSeekDelta(reasoning:' not in runner
+
+    proactive = text('lib/core/desire/proactive_engine.dart')
+    require(proactive, [
+        'rawReasoning: reasoning.toString().trim()',
+        'innerVoice: parsed.innerVoice.trim()',
+        'reasoning: candidate.innerVoice',
+        'reasoningContent: candidate.rawReasoning',
+        'innerVoice: candidate.innerVoice',
+        'Companion Voice 协议未形成，宁可等待下一次心跳',
+        'includeVoiceProtocol: false',
