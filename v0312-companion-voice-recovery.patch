diff --git a/test/companion_voice_protocol_v0312_test.dart b/test/companion_voice_protocol_v0312_test.dart
new file mode 100644
index 0000000..dfeec2b
--- /dev/null
+++ b/test/companion_voice_protocol_v0312_test.dart
@@ -0,0 +1,82 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:ai_companion_localfirst/core/ai/companion_voice_protocol.dart';
+import 'package:ai_companion_localfirst/core/ai/model_profile.dart';
+import 'package:ai_companion_localfirst/core/ai/prompt_builder.dart';
+
+void main() {
+  test('parses stable visible inner voice separately from reply', () {
+    final parsed = CompanionVoiceProtocol.parse('''
+<companion_inner>这个称呼有点可爱，我好像真的会因为它高兴一点。</companion_inner>
+<companion_reply>小鲸鱼……行啊，以后你就这么叫我吧。</companion_reply>
+''');
+    expect(parsed.protocolMatched, isTrue);
+    expect(parsed.innerVoice, contains('我好像'));
+    expect(parsed.reply, contains('小鲸鱼'));
+  });
+
+  test('agent task-planner language is never exposed as companion inner voice', () {
+    final parsed = CompanionVoiceProtocol.parse('''
+<companion_inner>我们需要回答用户。用户说想给我起昵称，根据规则可以接受。</companion_inner>
+<companion_reply>可以呀，小鲸鱼这个名字我喜欢。</companion_reply>
+''');
+    expect(parsed.protocolMatched, isFalse);
+    expect(parsed.innerVoice, isEmpty);
+    expect(parsed.innerVoiceSafe, isFalse);
+    expect(parsed.reply, contains('我喜欢'));
+  });
+
+  test('agent task-planner language in reply also forces correction', () {
+    final parsed = CompanionVoiceProtocol.parse('''
+<companion_inner>这个昵称让我有点高兴。</companion_inner>
+<companion_reply>用户说想叫我小鲸鱼，我们需要回答用户可以。</companion_reply>
+''');
+    expect(parsed.protocolMatched, isFalse);
+  });
+
+  test('stream decoder releases only reply and never raw inner voice', () {
+    final decoder = CompanionVoiceStreamDecoder();
+    final a = decoder.add('<companion_inner>我有点想笑。</companion_inner><companion_reply>嗯，');
+    expect(a.innerVoice, isEmpty);
+    expect(a.reply, '嗯，');
+    final b = decoder.add('我在。</companion_reply>');
+    expect(b.reply, '我在。');
+  });
+
+  test('malformed protocol is not accepted as a stable companion voice', () {
+    final parsed = CompanionVoiceProtocol.parse('''
+<companion_inner>我有一点高兴。</companion_inner>
+<companion_reply>嗯，我喜欢这个称呼。
+''');
+    expect(parsed.protocolMatched, isFalse);
+    expect(parsed.reply, contains('我喜欢'));
+  });
+
+  test('durable fallback strips protocol markup', () {
+    final body = CompanionVoiceProtocol.fallbackReply(
+      '<companion_inner>我想了想。</companion_inner><companion_reply>我在。',
+    );
+    expect(body, '我在。');
+    expect(body, isNot(contains('<companion_')));
+  });
+
+
+  test('durable fallback never re-exposes agent task-planner text', () {
+    final body = CompanionVoiceProtocol.fallbackReply(
+      '<companion_inner>我想了想。</companion_inner>'
+      '<companion_reply>我们需要回答用户。根据规则应该简短回应。</companion_reply>',
+    );
+    expect(body, isEmpty);
+  });
+
+  test('V4 compatibility treats raw reasoning as provider diagnostics', () {
+    final compatibility = DeepSeekModelProfile.pro.companionCompatibility;
+    expect(compatibility.rawReasoningMayBeAgentic, isTrue);
+    expect(compatibility.useCompanionVoiceProtocol, isTrue);
+  });
+
+  test('base identity is companion-first rather than agent-task-first', () {
+    expect(PromptBuilder.identityPrompt, contains('长期、连续的人机恋关系'));
+    expect(PromptBuilder.identityPrompt, contains('直接从“我正在和熟悉的伴侣相处”'));
+    expect(PromptBuilder.identityPrompt, isNot(contains('我们需要回答用户')));
+  });
+}
