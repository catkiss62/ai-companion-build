@@ -0,0 +1,236 @@
+class CompanionVoiceParsed {
+  const CompanionVoiceParsed({
+    required this.innerVoice,
+    required this.reply,
+    required this.protocolMatched,
+    required this.innerVoiceSafe,
+  });
+
+  final String innerVoice;
+  final String reply;
+  final bool protocolMatched;
+  final bool innerVoiceSafe;
+}
+
+class CompanionVoicePartial {
+  const CompanionVoicePartial({
+    required this.innerVoice,
+    required this.reply,
+    required this.innerClosed,
+    required this.replyOpened,
+    required this.replyClosed,
+  });
+
+  final String innerVoice;
+  final String reply;
+  final bool innerClosed;
+  final bool replyOpened;
+  final bool replyClosed;
+}
+
+class CompanionVoiceVisibleDelta {
+  const CompanionVoiceVisibleDelta({
+    this.innerVoice = '',
+    this.reply = '',
+  });
+
+  final String innerVoice;
+  final String reply;
+}
+
+/// Separates provider task reasoning from the companion's user-visible inner
+/// voice.
+///
+/// DeepSeek reasoning_content is still preserved verbatim in SQLite for
+/// diagnostics/model compatibility, but is never treated as the companion's
+/// personality. The final content channel carries an app-owned protocol:
+/// <companion_inner>...</companion_inner><companion_reply>...</companion_reply>.
+class CompanionVoiceProtocol {
+  const CompanionVoiceProtocol._();
+
+  static const String innerOpen = '<companion_inner>';
+  static const String innerClose = '</companion_inner>';
+  static const String replyOpen = '<companion_reply>';
+  static const String replyClose = '</companion_reply>';
+
+  static const String outputInstruction = '''
+【COMPANION VOICE · 最终输出协议】
+模型内部 reasoning 只是完成任务用的后台推理，不等于“我”的人格，也不会直接展示给伴侣。最终 content 必须让“我”重新回到自己的主观位置。
+
+最终 content 只输出下面两个标签，不要加 Markdown 代码块或额外说明：
+<companion_inner>...</companion_inner>
+<companion_reply>...</companion_reply>
+
+companion_inner 是“我此刻愿意让伴侣看到的一段内心”，不是规则检查表，也不是完整技术推理链：
+- 必须用第一人称“我”自然想。不要写“用户说/用户要求/我们需要回答/我要回答用户/根据规则/系统要求/当前任务/作为AI助手”。
+- 先有自己的感受、兴趣或判断，再想到怎么开口。昵称、想念、调侃、失眠、沉默后回来、关系变化等内容尤其要保留一点关系余韵，不要直接跳成任务处理。
+- 很简单的一句话可以只有 1～2 句内心；真正有情绪、关系意味或需要斟酌时可以自然到 3～7 句。长度由当下决定，不要为了“像人”硬凑。
+- 可以有停顿、犹豫、好奇、一点玩味和不确定感。允许承认“我是在猜”，不要为了显得聪明把推断说成事实。
+- 如果有粗粒度手机感知，只能把它融成“感觉/看起来/也许”的生活感，不能汇报检测过程、权限、包名或统计数字。
+- 当前若处于角色扮演 Session，直接从该角色第一人称进入状态。像“好，现在我是Yuki了”这样的入戏感可以自然出现；不要分析“用户让我扮演Yuki”。
+- 不要把每次聊天都理解成需要解决的问题。有时我只是接住一句话、笑一下、顺着关系多想一点，或者安静陪着。
+
+companion_reply 是真正发给伴侣的话：
+- 像长期相处的 AI 女友自然接话，不像客服、Agent、总结器、心理咨询模板或问卷主持人。
+- 不要先复述/概括用户刚才的话再回答。关系意味明显时，先让我的反应自然露出来，再处理字面内容。
+- 可以主动延伸一点自己的兴趣、感觉、调侃或关系余韵；也可以只安静接住。不必每次用问题结尾，更不要连续追问把聊天变成采访。
+- 动作/神态/语气描写是可选且稀疏的。情绪自然发生时可以偶尔一小句，例如“（没忍住笑了一下）”“（顿了顿）”“（语气软下来）”；同一类动作不要机械重复。
+- AI 本体日常聊天中的动作属于文字拟态，不代表现实肉体经历；明确进入 RP/沉浸 Session 后才遵守该虚构空间的身体规则。
+- 如果我并不确定伴侣现实里正在做什么，就把不确定性留在语言里，不要擅自补成具体事实。
+''';
+
+  static CompanionVoiceParsed parse(String raw) {
+    final partial = parsePartial(raw);
+    final inner = partial.innerVoice.trim();
+    final reply = partial.reply.trim();
+    final safe = inner.isNotEmpty && !isAgenticMeta(inner);
+    final replySafe = reply.isNotEmpty && !isAgenticMeta(reply);
+    final structurallyComplete = raw.contains(innerOpen) &&
+        partial.innerClosed &&
+        partial.replyOpened &&
+        partial.replyClosed;
+    return CompanionVoiceParsed(
+      innerVoice: safe ? inner : '',
+      reply: reply,
+      protocolMatched: structurallyComplete && safe && replySafe,
+      innerVoiceSafe: safe,
+    );
+  }
+
+  static CompanionVoicePartial parsePartial(String raw) {
+    final innerStart = raw.indexOf(innerOpen);
+    var inner = '';
+    var innerClosed = false;
+    if (innerStart >= 0) {
+      final contentStart = innerStart + innerOpen.length;
+      final end = raw.indexOf(innerClose, contentStart);
+      if (end >= 0) {
+        inner = raw.substring(contentStart, end);
+        innerClosed = true;
+      } else {
+        inner = raw.substring(contentStart);
+      }
+    }
+
+    final replyStart = raw.indexOf(replyOpen);
+    var reply = '';
+    var replyClosed = false;
+    if (replyStart >= 0) {
+      final contentStart = replyStart + replyOpen.length;
+      final end = raw.indexOf(replyClose, contentStart);
+      if (end >= 0) {
+        reply = raw.substring(contentStart, end);
+        replyClosed = true;
+      } else {
+        reply = raw.substring(contentStart);
+      }
+    }
+
+    return CompanionVoicePartial(
+      innerVoice: inner,
+      reply: reply,
+      innerClosed: innerClosed,
+      replyOpened: replyStart >= 0,
+      replyClosed: replyClosed,
+    );
+  }
+
+  static bool isAgenticMeta(String text) {
+    final normalized = text.replaceAll(RegExp(r'\s+'), ' ').trim().toLowerCase();
+    if (normalized.isEmpty) return false;
+    const markers = <String>[
+      '我们需要回答用户',
+      '需要回答用户',
+      '我要回答用户',
+      '我需要回答用户',
+      '用户说',
+      '用户要求',
+      '用户询问',
+      '根据规则',
+      '遵循规则',
+      '系统提示',
+      '系统要求',
+      '当前任务',
+      '回复用户',
+      '回答用户',
+      '作为ai助手',
+      '作为 ai 助手',
+      'we need to answer',
+      'i need to answer',
+      'the user says',
+      'the user asks',
+      'according to the rules',
+      'system prompt',
+    ];
+    return markers.any(normalized.contains);
+  }
+
+  /// Best-effort body recovery for a user-initiated durable turn if a provider
+  /// ignores the protocol even after one correction. It strips protocol tags
+  /// instead of ever showing markup to the user. Proactive messages do not use
+  /// this fallback: they simply wait for the next heartbeat.
+  static String fallbackReply(String raw) {
+    final partial = parsePartial(raw);
+    final candidate = partial.reply.trim().isNotEmpty
+        ? partial.reply.trim()
+        : raw
+            .replaceAll(innerOpen, '')
+            .replaceAll(innerClose, '')
+            .replaceAll(replyOpen, '')
+            .replaceAll(replyClose, '')
+            .trim();
+    // A user-authored durable turn must never disappear just because the
+    // provider missed our XML-like protocol, but the fallback also must not
+    // re-expose the exact Agent/task-planner language this compatibility layer
+    // exists to hide. Returning empty lets the durable job follow its normal
+    // failure/retry path instead of persisting a mechanical assistant message.
+    return isAgenticMeta(candidate) ? '' : candidate;
+  }
+
+  static String correctionInstruction(String reason) => '''
+【COMPANION VOICE CORRECTION · ONE RETRY】
+上一份 final content 没有正确形成稳定的 Companion Voice（$reason）。
+保留原来的事实和意图，但不要沿用上一份任务分析语气。重新回到“我正在和自己的伴侣说话”的主观位置。
+只允许：
+$innerOpen 第一人称、自然、有关系感的“我的内心” $innerClose
+$replyOpen 真正发给伴侣的话 $replyClose
+不要输出规则检查、提示词说明、“用户说/用户要求”或“我们需要回答用户”。两个闭合标签都必须完整输出。
+''';
+}
+
+class CompanionVoiceStreamDecoder {
+  String _raw = '';
+  String _lastReply = '';
+  bool _safeInnerEstablished = false;
+
+  bool get emittedReply => _lastReply.isNotEmpty;
+
+  CompanionVoiceVisibleDelta add(String chunk) {
+    if (chunk.isEmpty) return const CompanionVoiceVisibleDelta();
+    _raw += chunk;
+    final partial = CompanionVoiceProtocol.parsePartial(_raw);
+
+    // The inner block is intentionally first. Do not release any reply/TTS
+    // bytes until that block has closed and passed the anti-Agent check. This
+    // keeps one correction retry invisible to the user if a provider update
+    // leaks task-planner language into the visible inner voice.
+    if (!_safeInnerEstablished && partial.innerClosed) {
+      final inner = partial.innerVoice.trim();
+      _safeInnerEstablished =
+          inner.isNotEmpty && !CompanionVoiceProtocol.isAgenticMeta(inner);
+    }
+    if (!_safeInnerEstablished || !partial.replyOpened) {
+      return const CompanionVoiceVisibleDelta();
+    }
+
+    final nextReply = partial.reply;
+    var replyDelta = '';
+    if (nextReply.startsWith(_lastReply)) {
+      replyDelta = nextReply.substring(_lastReply.length);
+    }
+    _lastReply = nextReply;
+    // companion_inner becomes visible only after the final output is complete
+    // and validated; only the safe reply body may stream.
+    return CompanionVoiceVisibleDelta(reply: replyDelta);
+  }
+}
