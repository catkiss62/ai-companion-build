+      final delta = (desire.baselines[drive] ?? anchors[drive]!) - anchors[drive]!;
+      if (delta >= 0.006) {
+        labels.add(higher);
+      } else if (delta <= -0.006) {
+        labels.add(lower);
+      }
+    }
+
+    add(DriveKey.attachment, '更容易主动靠近和维系连接', '更尊重彼此的独立空间');
