+    add(DriveKey.social, '更愿意随手分享和主动开口', '更偏爱安静而有内容的交流');
+    add(DriveKey.stress, '面对关系波动时更敏感', '面对关系波动时更从容');
+    return labels.isEmpty ? '仍接近初始状态；具体偏好以长期记忆中的已确认事实为准' : labels.join('；');
+  }
