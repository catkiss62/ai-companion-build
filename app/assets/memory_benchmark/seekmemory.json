      "kind": "emotion",
      "importance": 0.9,
      "arousal": 0.9,
      "valence": -0.8,
      "mentions": 4,
      "tags": [
        "情绪",
        "心情",
        "工作"
      ]
    },
    {
      "day": 13,
      "text": "他说最近睡不着",
