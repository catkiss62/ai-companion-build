+        val maxX = (safe.right - size).coerceAtLeast(safe.left)
+        val maxY = (safe.bottom - size).coerceAtLeast(safe.top)
+        return bubbleParams.x in safe.left..maxX && bubbleParams.y in safe.top..maxY
+    }
